NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/secure_auth

# Generate each with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=replace-me-with-a-long-random-value-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-me-with-a-different-long-random-value-32-chars
MFA_TOKEN_SECRET=replace-me-with-a-third-long-random-value-32-chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
MFA_TOKEN_TTL=5m
BCRYPT_SALT_ROUNDS=12

CLIENT_ORIGINS=http://localhost:5173
MFA_ISSUER=SecureAuth

# Used by `npm run seed:admin` to create the first admin account.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_NAME=Administrator
